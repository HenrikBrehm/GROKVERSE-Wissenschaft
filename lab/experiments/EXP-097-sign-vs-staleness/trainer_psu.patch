+def test_pre_switch_update(tmp: Path) -> None:
+    """EXP-097 (session 43): --pre-switch-update normgd. Before the switch each step is a LINEAR normalised gradient step
+    W <- W (1 - lr wd) - lr g / rms(g) per tensor, W_E token rows as one block (no elementwise sign), while the AdamW moments and step counter are updated
+    from the same gradients (shadow state), so AdamW continues after the switch with a state like the Adam arm. With a reused gradient (--pre-switch-grad-every 2) the second step repeats the first exactly (up to the
+    decay factor): D2 = (2 - lr wd) D1 with D_t = W_t - (1 - lr wd)^t W_0. Default Adam step 1 is sign-like, normgd is not.
+    Fingerprint/run id change only when given; invalid combinations are refused."""
+    import numpy as np
+    f1 = fb.run_fingerprint(ns())[0]
+    assert fb.run_fingerprint(ns(pre_switch_update="adam"))[0] == f1, "default --pre-switch-update changed the fingerprint"
+    assert fb.run_fingerprint(ns(pre_switch_update="normgd"))[0] != f1, "fingerprint ignores --pre-switch-update"
+    out = tmp / "psu"
+    spl = ROOT / "lab/experiments/EXP-056-overlap-persistence/splits"
+    base = [sys.executable, str(FB), "--seed", "400", "--condition", "baseline", "--threads", "1", "--out-root", str(out),
+            "--split-file", str(spl / "seed400_w0_A.npy"), "--test-file", str(spl / "seed400_test.npy")]
+    sw = ["--switch-split-file", str(spl / "seed400_w0_B.npy"), "--steps", "14", "--switch-step", "10", "--spectra-at", "1,2,10"]
+    run = lambda *x: subprocess.run(base + list(x), cwd=ROOT, capture_output=True, text=True, timeout=600)   # noqa: E731
+    for extra in (sw + ["--pre-switch-update", "normgd"],
+                  sw + ["--pre-switch-update", "normgd", "--pre-switch-grad-every", "2"],
+                  sw):
+        r = run(*extra)
+        assert r.returncode == 0, (extra, r.stdout + r.stderr)
+    d = {}
+    for k in ("at10_psunormgd", "at10_ge2_psunormgd", "at10"):
+        hits = [h for h in out.glob(f"*{k}") if h.is_dir()]
+        assert len(hits) == 1, (k, list(out.iterdir()))
+        d[k] = hits[0]
+    snap = lambda k, s: np.load(d[k] / "we_snapshots.npy")[list(np.load(d[k] / "we_snapshot_steps.npy")).index(s)].astype(np.float64)   # noqa: E731
+    lam = 1e-3 * 1.0                                   # preset lr * wd (arch25k)
+    for k in d:
+        assert np.array_equal(snap(k, 0), snap("at10", 0)), ("init differs", k)
+    W0 = snap("at10", 0)
+    D1 = {k: snap(k, 1) - (1 - lam) * W0 for k in d}
+    sign_share = {k: float(np.mean(np.abs(np.abs(D1[k]) - 1e-3) <= 1e-4)) for k in d}
+    assert sign_share["at10"] > 0.9, ("default Adam step 1 is not sign-like", sign_share)
+    assert sign_share["at10_psunormgd"] < 0.3, ("normgd step 1 looks like a sign step", sign_share)
+    rms1 = float(np.sqrt(np.mean(D1["at10_psunormgd"] ** 2)))            # W_E token rows are normalised as one block
+    assert abs(rms1 / 1e-3 - 1) < 0.01, ("normgd step 1 on the W_E token rows is not RMS lr (double update?)", rms1)
+    assert np.allclose(D1["at10_psunormgd"], D1["at10_ge2_psunormgd"], atol=1e-7), "step 1 differs between normgd arms"
+    D2 = snap("at10_ge2_psunormgd", 2) - (1 - lam) ** 2 * W0
+    assert np.allclose(D2, (2 - lam) * D1["at10_ge2_psunormgd"], rtol=1e-3, atol=1e-6), "reused normgd step is not linear"
+    D2f = snap("at10_psunormgd", 2) - (1 - lam) ** 2 * W0
+    assert float(np.abs(D2f - D2).max()) > 1e-6, "fresh normgd step 2 equals the reused one"
+    res = json.loads((d["at10_ge2_psunormgd"] / "result.json").read_text(encoding="utf-8"))
+    ev = res["events"]["pre_switch_update"]
+    assert ev["mode"] == "normgd" and ev["steps"] == 10 and ev["adam_step_at_switch"] == 10, ev
+    assert np.isfinite(ev["adam_exp_avg_norm_W_E"]) and ev["adam_exp_avg_norm_W_E"] > 0, ev   # shadow Adam state was built
+    assert res["pre_switch_update"] == "normgd" and res["pre_switch_grad_every"] == 2, res.get("pre_switch_update")
+    for bad in (["--steps", "14", "--pre-switch-update", "normgd"],                                   # no switch
+                sw + ["--pre-switch-update", "normgd", "--pre-switch-betas", "0.5,0.9"],
+                sw + ["--pre-switch-update", "normgd", "--lr-scale", "2"],
+                sw + ["--pre-switch-update", "sgd"]):
+        r = run(*bad)
+        assert r.returncode != 0, bad
+
