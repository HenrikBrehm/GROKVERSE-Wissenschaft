+def test_we_fourier_adam(tmp: Path) -> None:
+    """N49 (session 43): --we-fourier-adam. AdamW acts on C = B^T W_E[:p] (orthonormal real DFT basis B) instead of the token
+    rows: same init, step 1 is a sign step in DFT coordinates (B^T D1 entries +-lr) but not in token coordinates, and W_E stays
+    equal to B C. Default runs keep sign steps in token coordinates. Fingerprint/run id change only when given; invalid
+    combinations are refused."""
+    import numpy as np
+    f1 = fb.run_fingerprint(ns())[0]
+    assert fb.run_fingerprint(ns(we_fourier_adam=False))[0] == f1, "default --we-fourier-adam changed the fingerprint"
+    assert fb.run_fingerprint(ns(we_fourier_adam=True))[0] != f1, "fingerprint ignores --we-fourier-adam"
+    out = tmp / "wef"
+    spl = ROOT / "lab/experiments/EXP-056-overlap-persistence/splits"
+    base = [sys.executable, str(FB), "--seed", "400", "--condition", "baseline", "--threads", "1", "--out-root", str(out),
+            "--split-file", str(spl / "seed400_w0_A.npy"), "--test-file", str(spl / "seed400_test.npy")]
+    sw = ["--switch-split-file", str(spl / "seed400_w0_B.npy"), "--steps", "14", "--switch-step", "10", "--spectra-at", "1,2,10"]
+    run = lambda *x: subprocess.run(base + list(x), cwd=ROOT, capture_output=True, text=True, timeout=600)   # noqa: E731
+    for extra in (sw + ["--we-fourier-adam"], sw + ["--we-fourier-adam", "--pre-switch-grad-every", "2"], sw):
+        r = run(*extra)
+        assert r.returncode == 0, (extra, r.stdout + r.stderr)
+    d = {}
+    for k in ("at10_wef", "at10_ge2_wef", "at10"):
+        hits = [h for h in out.glob(f"*{k}") if h.is_dir()]
+        assert len(hits) == 1, (k, list(out.iterdir()))
+        d[k] = hits[0]
+    snap = lambda k, s: np.load(d[k] / "we_snapshots.npy")[list(np.load(d[k] / "we_snapshot_steps.npy")).index(s)].astype(np.float64)   # noqa: E731
+    B = fb.fourier_basis(113)
+    lam = 1e-3 * 1.0
+    W0 = snap("at10", 0)
+    for k in d:
+        assert np.array_equal(snap(k, 0), W0), ("init differs", k)
+    band = lambda X: float(np.mean(np.abs(np.abs(X) - 1e-3) <= 1e-4))   # noqa: E731
+    D_wef, D_def = snap("at10_wef", 1) - (1 - lam) * W0, snap("at10", 1) - (1 - lam) * W0
+    assert band(B.T @ D_wef) > 0.9, ("step 1 is not a sign step in DFT coordinates", band(B.T @ D_wef))
+    assert band(D_wef) < 0.3, ("step 1 of --we-fourier-adam looks like a token-basis sign step", band(D_wef))
+    assert band(D_def) > 0.9 and band(B.T @ D_def) < 0.3, ("default step 1 not a token-basis sign step", band(D_def), band(B.T @ D_def))
+    assert not np.array_equal(snap("at10_wef", 10), snap("at10", 10)), "--we-fourier-adam had no effect"
+    D2 = snap("at10_ge2_wef", 2) - (1 - lam) ** 2 * W0          # reused gradient: second Adam step in C equals the first
+    assert np.allclose(D2, (2 - lam) * (snap("at10_ge2_wef", 1) - (1 - lam) * W0), rtol=1e-3, atol=1e-6), "reused step differs"
+    res = json.loads((d["at10_wef"] / "result.json").read_text(encoding="utf-8"))
+    ev = res["events"]["we_fourier_adam"]
+    assert res["we_fourier_adam"] is True and ev["steps"] == 14 and ev["max_coord_dev"] < 1e-4, ev
+    for bad in (sw + ["--we-fourier-adam", "--pre-switch-update", "normgd"],
+                sw + ["--we-fourier-adam", "--pre-switch-betas", "0.5,0.9"],
+                sw + ["--we-fourier-adam", "--task", "mul"],
+                sw + ["--we-fourier-adam", "--condition", "ban_random"]):   # argparse: the last --condition wins
+        r = run(*bad)
+        assert r.returncode != 0, bad
+
