+def test_sgd_clip(tmp: Path) -> None:
+    """EXP-128 (session 58): --sgd-clip clips the global gradient norm before each sgdm step. The default leaves the
+    fingerprint unchanged; with a tiny clip the step is at most lr * clip beyond the decoupled decay; every step is counted
+    as clipped; the run id carries _clip; invalid uses are refused."""
+    import numpy as np
+    f1 = fb.run_fingerprint(ns())[0]
+    assert fb.run_fingerprint(ns(sgd_clip=None))[0] == f1, "default --sgd-clip changed the fingerprint"
+    out = tmp / "clip"
+    spl = ROOT / "lab/experiments/EXP-056-overlap-persistence/splits"
+    base = [sys.executable, str(FB), "--seed", "400", "--condition", "baseline", "--threads", "1", "--out-root", str(out),
+            "--split-file", str(spl / "seed400_w0_A.npy"), "--test-file", str(spl / "seed400_test.npy")]
+    run = lambda *x: subprocess.run(base + list(x), cwd=ROOT, capture_output=True, text=True, timeout=600)   # noqa: E731
+    r = run("--steps", "2", "--optimizer", "sgdm", "--sgd-lr", "0.1", "--sgd-momentum", "0.0", "--sgd-clip", "1e-06",
+            "--spectra-at", "1")
+    assert r.returncode == 0, r.stdout + r.stderr
+    hits = [h for h in out.glob("*sgdm0.1_0.0_clip1e-06") if h.is_dir()]
+    assert len(hits) == 1, list(out.iterdir())
+    res = json.loads((hits[0] / "result.json").read_text(encoding="utf-8"))
+    assert res["events"]["sgd_clip"] == {"max_norm": 1e-06, "clipped_steps": 2}, res["events"].get("sgd_clip")
+    snaps = np.load(hits[0] / "we_snapshots.npy").astype(np.float64)
+    steps = list(np.load(hits[0] / "we_snapshot_steps.npy"))
+    D = snaps[steps.index(1)] - (1 - 1e-3) * snaps[steps.index(0)]
+    assert float(np.linalg.norm(D)) < 1e-5, float(np.linalg.norm(D))   # lr * clip = 1e-7, plus float32 snapshot resolution
+    r = run("--steps", "2", "--optimizer", "sgdm", "--sgd-lr", "0.1", "--sgd-momentum", "0.0", "--sgd-clip", "1000000.0",
+            "--spectra-at", "1")                                                          # clip far above the gradient norm
+    assert r.returncode == 0, r.stdout + r.stderr
+    h2 = next(h for h in out.glob("*sgdm0.1_0.0_clip1000000.0") if h.is_dir())
+    assert json.loads((h2 / "result.json").read_text(encoding="utf-8"))["events"]["sgd_clip"]["clipped_steps"] == 0
+    s2 = np.load(h2 / "we_snapshots.npy").astype(np.float64)
+    D2 = s2[steps.index(1)] - (1 - 1e-3) * s2[steps.index(0)]
+    assert float(np.linalg.norm(D2)) > 100 * float(np.linalg.norm(D)), (float(np.linalg.norm(D2)), float(np.linalg.norm(D)))
+    for bad in (["--steps", "2", "--sgd-clip", "1.0"],                                             # clip without sgdm
+                ["--steps", "2", "--optimizer", "sgdm", "--sgd-lr", "0.1", "--sgd-clip", "0"],
+                ["--steps", "2", "--optimizer", "sgdm", "--sgd-lr", "0.1", "--sgd-clip", "nan"]):
+        assert run(*bad).returncode != 0, bad
+
